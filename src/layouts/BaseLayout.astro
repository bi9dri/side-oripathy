---
import "../styles/global.css";
import type { DocNavItem } from "../lib/docs-nav";

interface Props {
	title: string;
	description: string;
	currentPath: string;
	sidebarDocs?: readonly DocNavItem[];
	currentDocSlug?: string;
}

const { title, description, currentPath, sidebarDocs = [], currentDocSlug } = Astro.props;
const siteTitle = "アークナイツ×エモクロアTRPG サイド・オリパシー";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/img/icon.webp", Astro.site);
const year = new Date().getFullYear();

const isDocsActive = currentPath.startsWith("/docs");
const isConverterActive = currentPath === "/converter" || currentPath === "/converter/";
const isCalculatorActive =
	currentPath === "/erosion-calculator" || currentPath === "/erosion-calculator/";
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			(() => {
				const meta = document.querySelector('meta[name="color-scheme"]');
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				let stored = null;
				try {
					stored = localStorage.getItem("color-scheme");
				} catch {}
				if (stored === "light" || stored === "dark") {
					if (meta) meta.setAttribute("content", stored);
					document.documentElement.dataset.theme = stored;
				} else {
					if (meta) meta.setAttribute("content", "light dark");
					document.documentElement.dataset.theme = prefersDark ? "dark" : "light";
				}
			})();
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:image" content={ogImageUrl.href} />
		<link rel="icon" href="/img/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png" />
		<link rel="manifest" href="/img/site.webmanifest" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
			/>
		</noscript>
		<script defer src="https://www.googletagmanager.com/gtag/js?id=G-YT5ST8BYXJ"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				window.dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-YT5ST8BYXJ", { anonymize_ip: true });
		</script>
	</head>
	<body>
		<header class="site-header">
			<nav class="site-navbar" aria-label="ナビゲーション">
				<div class="navbar-left">
					<button
						type="button"
						id="mobile-menu-open"
						class="icon-button mobile-only"
						aria-label="ナビゲーションバーを開く"
						aria-controls="mobile-drawer"
						aria-expanded="false"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="3" y1="6" x2="21" y2="6" />
							<line x1="3" y1="12" x2="21" y2="12" />
							<line x1="3" y1="18" x2="21" y2="18" />
						</svg>
					</button>
					<a class="navbar-brand" href="/">{siteTitle}</a>
					<ul class="navbar-links desktop-only">
						<li>
							<a href="/docs/intro" aria-current={isDocsActive ? "page" : undefined}>ルール</a>
						</li>
						<li>
							<a href="/converter" aria-current={isConverterActive ? "page" : undefined}>コンバーター</a>
						</li>
						<li>
							<a href="/erosion-calculator" aria-current={isCalculatorActive ? "page" : undefined}>侵食判定計算機</a>
						</li>
					</ul>
				</div>
				<div class="navbar-right">
					<a
						class="navbar-external desktop-only"
						href="https://github.com/bi9dri/side-oripathy"
						target="_blank"
						rel="noopener noreferrer"
					>
						GitHub
					</a>
					<button
						type="button"
						id="theme-toggle"
						class="icon-button"
						aria-label="ダークモードを切り替える"
					>
						<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="4" />
							<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
						</svg>
						<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
						</svg>
					</button>
				</div>
			</nav>
		</header>

		<dialog id="mobile-drawer" class="mobile-drawer" aria-label="モバイルナビゲーション">
			<div class="drawer-sheet">
				<div class="drawer-header">
					<span class="drawer-title">SIDE:ORIPATHY</span>
					<button
						type="button"
						id="mobile-menu-close"
						class="icon-button"
						aria-label="メニューを閉じる"
						autofocus
					>
						<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="18" y1="6" x2="6" y2="18" />
							<line x1="6" y1="6" x2="18" y2="18" />
						</svg>
					</button>
				</div>
				<nav class="drawer-nav" aria-label="モバイルメニュー">
					<ul class="drawer-list">
						<li>
							<a href="/docs/intro" aria-current={isDocsActive ? "page" : undefined}>ルール</a>
						</li>
						<li>
							<a href="/converter" aria-current={isConverterActive ? "page" : undefined}>コンバーター</a>
						</li>
						<li>
							<a href="/erosion-calculator" aria-current={isCalculatorActive ? "page" : undefined}>侵食判定計算機</a>
						</li>
						<li>
							<a href="https://github.com/bi9dri/side-oripathy" target="_blank" rel="noopener noreferrer">GitHub</a>
						</li>
					</ul>
					{
						sidebarDocs.length > 0 && (
							<div class="drawer-docs">
								<p class="drawer-section-label">ルール一覧</p>
								<ul class="drawer-list">
									{sidebarDocs.map((doc) => (
										<li>
											<a
												href={`/docs/${doc.slug}`}
												aria-current={doc.slug === currentDocSlug ? "page" : undefined}
											>
												{doc.title}
											</a>
										</li>
									))}
								</ul>
							</div>
						)
					}
				</nav>
			</div>
		</dialog>

		<div class="site-main">
			<slot />
		</div>

		<footer class="site-footer">
			<p class="footer-copyright">© {year} bidri // SIDE:ORIPATHY TERMINAL</p>
		</footer>

		<script>
			const metaColorScheme = document.querySelector('meta[name="color-scheme"]');
			const themeToggleButton = document.getElementById("theme-toggle");
			const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

			function getStoredScheme(): "light" | "dark" | null {
				try {
					const val = localStorage.getItem("color-scheme");
					return val === "light" || val === "dark" ? val : null;
				} catch {
					return null;
				}
			}

			function applyScheme(stored: "light" | "dark" | null) {
				const resolved = stored ?? (darkQuery.matches ? "dark" : "light");
				metaColorScheme?.setAttribute("content", stored ?? "light dark");
				document.documentElement.dataset.theme = resolved;
			}

			themeToggleButton?.addEventListener("click", () => {
				const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
				const target = current === "dark" ? "light" : "dark";
				const system = darkQuery.matches ? "dark" : "light";
				const nextStored = target === system ? null : target;
				try {
					if (nextStored === null) {
						localStorage.removeItem("color-scheme");
					} else {
						localStorage.setItem("color-scheme", nextStored);
					}
				} catch {}
				applyScheme(nextStored);
			});

			darkQuery.addEventListener("change", () => {
				if (getStoredScheme() === null) {
					applyScheme(null);
				}
			});

			window.addEventListener("storage", (event) => {
				if (event.key === "color-scheme") {
					applyScheme(getStoredScheme());
				}
			});

			const drawer = document.getElementById("mobile-drawer") as HTMLDialogElement | null;
			const openButton = document.getElementById("mobile-menu-open");
			const closeButton = document.getElementById("mobile-menu-close");
			const sheet = drawer?.querySelector(".drawer-sheet");

			openButton?.addEventListener("click", () => {
				if (!drawer) return;
				drawer.showModal();
				openButton.setAttribute("aria-expanded", "true");
			});

			closeButton?.addEventListener("click", () => {
				drawer?.close();
			});

			drawer?.addEventListener("click", (event) => {
				if (sheet && event.target instanceof Node && !sheet.contains(event.target)) {
					drawer.close();
				}
			});

			drawer?.addEventListener("close", () => {
				openButton?.setAttribute("aria-expanded", "false");
			});
		</script>
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: var(--prts-layout-border-width) solid var(--prts-layout-border);
		background-color: var(--prts-glass-bg);
		backdrop-filter: blur(var(--prts-glass-blur));
		-webkit-backdrop-filter: blur(var(--prts-glass-blur));
	}

	.site-navbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--prts-space-md);
		min-height: var(--prts-navbar-height);
		padding: 0 var(--prts-space-md);
	}

	.navbar-left,
	.navbar-right {
		display: flex;
		align-items: center;
		gap: var(--prts-space-md);
		min-width: 0;
	}

	.navbar-brand {
		font-family: var(--prts-font-heading);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--prts-accent);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		padding: 0.5rem 0;
	}

	.navbar-links {
		display: flex;
		align-items: center;
		gap: var(--prts-space-xs);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.navbar-links a,
	.navbar-external {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 0.65rem;
		font-family: var(--prts-font-heading);
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		color: var(--prts-text-primary);
		border-bottom: 2px solid transparent;
	}

	.navbar-links a:hover,
	.navbar-external:hover,
	.navbar-links a[aria-current="page"] {
		color: var(--prts-accent);
	}

	.navbar-links a[aria-current="page"] {
		border-bottom-color: var(--prts-accent);
	}

	.icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		padding: 0;
		border: 1px solid transparent;
		background: transparent;
		color: var(--prts-text-primary);
		cursor: pointer;
	}

	.icon-button:hover {
		color: var(--prts-accent);
		background-color: var(--prts-accent-dim);
	}

	:global(html[data-theme="dark"]) .icon-moon {
		display: none;
	}

	:global(html[data-theme="light"]) .icon-sun {
		display: none;
	}

	.mobile-only {
		display: none;
	}

	.mobile-drawer {
		inset: 0;
		width: auto;
		height: auto;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
	}

	.mobile-drawer::backdrop {
		background: rgba(0, 0, 0, 0.5);
	}

	.drawer-sheet {
		display: flex;
		flex-direction: column;
		width: min(20rem, 84dvw);
		height: 100svh;
		background-color: var(--prts-bg-surface);
		border-right: 1px solid var(--prts-border);
		overflow-y: auto;
	}

	.drawer-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--prts-space-sm) var(--prts-space-md);
		border-bottom: 1px solid var(--prts-border);
	}

	.drawer-title {
		font-family: var(--prts-font-heading);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--prts-accent);
	}

	.drawer-nav {
		padding: var(--prts-space-md);
	}

	.drawer-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--prts-space-xs);
	}

	.drawer-list a {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--prts-space-md);
		color: var(--prts-text-primary);
		font-size: 0.92rem;
		border-left: 2px solid transparent;
	}

	.drawer-list a:hover,
	.drawer-list a[aria-current="page"] {
		background-color: var(--prts-accent-dim);
		color: var(--prts-accent);
	}

	.drawer-list a[aria-current="page"] {
		border-left-color: var(--prts-accent);
	}

	.drawer-docs {
		margin-top: var(--prts-space-lg);
		padding-top: var(--prts-space-md);
		border-top: 1px solid var(--prts-border);
	}

	.drawer-section-label {
		margin: 0 0 var(--prts-space-sm);
		padding: 0 var(--prts-space-md);
		font-family: var(--prts-font-heading);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		color: var(--prts-text-secondary);
	}

	.site-footer {
		border-top: var(--prts-layout-border-width) solid var(--prts-layout-border);
		background-color: var(--prts-glass-bg);
		padding: var(--prts-space-lg) var(--prts-space-md);
		text-align: center;
	}

	.footer-copyright {
		margin: 0;
		font-family: var(--prts-font-heading);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		color: var(--prts-text-secondary);
	}

	@media (max-width: 996px) {
		.desktop-only {
			display: none;
		}

		.mobile-only {
			display: inline-flex;
		}
	}
</style>
