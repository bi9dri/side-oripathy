{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  automerge: true,
  automergeType: 'pr',
  constraints: {
    ghActionsLock: 'v0.4.1',
  },
  rangeStrategy: 'pin',
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  dependencyDashboard: {
    enabled: true,
    osvVulnerabilitySummary: 'unresolved',
  },
  osvVulnerabilityAlerts: true,
  semanticCommits: 'enabled',
  commitMessageAction: '更新',
  commitMessageExtra: '({{currentVersion}} → {{newVersion}})',
  prConcurrentLimit: 5,
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },
  packageRules: [
    {
      groupName: 'bun',
      matchPackageNames: [
        'bun',
        '@types/bun',
      ],
      dependencyDashboardApproval: true,
    },
    {
      matchManagers: [
        'devbox',
      ],
      dependencyDashboardApproval: true,
      prBodyNotes: [
        '⚠️ `devbox.lock` は Renovate では更新されません。このブランチで `devbox install` を実行してコミットしてください。',
      ],
    },
    {
      groupName: 'astro',
      matchPackageNames: [
        'astro',
        '@astrojs/**',
      ],
    },
    {
      groupName: 'playwright',
      matchPackageNames: [
        '@playwright/test',
        'playwright-core',
      ],
    },
    {
      groupName: 'non-major dependencies',
      matchManagers: [
        'bun',
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '!bun',
        '!@types/bun',
      ],
    },
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
    },
  ],
}
