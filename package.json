{
  "name": "emoklore-arknights-side-oripathy",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "ncu": "ncu --cooldown 7",
    "test/logic/unit": "bun test --coverage src/lib/",
    "test/logic": "bun run test/logic/unit",
    "test/content/prose": "textlint docs/",
    "test/content/links": "lychee --config .lychee.toml docs/",
    "test/content": "bun run test/content/prose",
    "test/visual/e2e": "playwright test",
    "test/visual/perf": "lhci autorun",
    "test/visual": "bun run build && bun run test/visual/e2e && bun run test/visual/perf",
    "test": "bun run test/logic && bun run test/content"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-google-gtag": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "npm-check-updates": "23.0.2",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@argos-ci/cli": "6.9.0",
    "@argos-ci/playwright": "7.4.6",
    "@axe-core/playwright": "4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.13",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "playwright-core": "1.62.1",
    "textlint": "15.8.0",
    "textlint-plugin-mdx": "1.1.0",
    "textlint-rule-no-mix-dearu-desumasu": "6.0.4",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "typescript": "7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "patchedDependencies": {
    "chrome-launcher@1.2.1": "patches/chrome-launcher@1.2.1.patch"
  },
  "overrides": {
    "websocket-driver": "0.7.5",
    "shell-quote": "1.10.0"
  }
}