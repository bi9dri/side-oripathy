{
  "name": "emoklore-arknights-side-oripathy",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "ncu": "ncu --cooldown 7",
    "test/logic/unit": "bun test --coverage src/lib/",
    "test/logic": "bun run test/logic/unit",
    "test/content/prose": "textlint docs/",
    "test/content/links": "lychee --config .lychee.toml docs/",
    "test/content": "bun run test/content/prose",
    "test/visual/e2e": "playwright test",
    "test/visual/perf": "lhci autorun",
    "test/visual": "bun run build && bun run test/visual/e2e && bun run test/visual/perf",
    "test": "bun run test/logic && bun run test/content"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/plugin-google-gtag": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "npm-check-updates": "19.3.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@argos-ci/cli": "5.0.4",
    "@argos-ci/playwright": "6.6.2",
    "@axe-core/playwright": "4.11.2",
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.59.1",
    "@types/bun": "1.3.11",
    "oxfmt": "0.27.0",
    "oxlint": "1.42.0",
    "textlint": "15.5.4",
    "textlint-plugin-mdx": "1.1.0",
    "textlint-rule-no-mix-dearu-desumasu": "6.0.4",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "typescript": "6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "patchedDependencies": {
    "chrome-launcher@1.2.1": "patches/chrome-launcher@1.2.1.patch"
  }
}