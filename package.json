{
  "name": "emoklore-arknights-side-oripathy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "astro preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "astro sync && tsc --noEmit",
    "check:bun-version": "bash scripts/check-bun-version.sh",
    "test/logic/unit": "bun test --coverage src/lib/",
    "test/logic": "bun run test/logic/unit",
    "test/content/prose": "textlint docs/",
    "test/content/links": "lychee --config .lychee.toml docs/",
    "test/content": "bun run test/content/prose",
    "test/visual/e2e": "playwright test",
    "test/visual/e2e:update": "playwright test --update-snapshots",
    "test/visual/perf": "lhci autorun",
    "test/visual": "bun run build && bun run test/visual/e2e && bun run test/visual/perf",
    "test": "bun run test/logic && bun run test/content"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "astro": "7.4.12",
    "remark-directive": "4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.3.13",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright-core": "1.65.1",
    "textlint": "16.0.0",
    "textlint-rule-no-mix-dearu-desumasu": "6.0.4",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "chrome-launcher@1.2.1": "patches/chrome-launcher@1.2.1.patch"
  }
}